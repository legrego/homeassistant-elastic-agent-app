#!/usr/bin/env bash
# Prints the CHANGELOG.md section for a version, without its heading.
# Fails when the changelog has no "## <version>" section or it is empty, so a
# version can't be published without release notes.
#
# Usage: release-notes <version> [changelog]
set -euo pipefail

version="${1:?usage: release-notes <version> [changelog]}"
changelog="${2:-elastic_agent/CHANGELOG.md}"

notes="$(awk -v heading="## ${version}" '
  $0 == heading { found = 1; next }
  found && /^## / { exit }
  found { print }
' "${changelog}" | sed -e '/./,$!d')"

if [[ -z "${notes//[[:space:]]/}" ]]; then
  echo "error: ${changelog} has no entry for ${version}. Add a \"## ${version}\" section." >&2
  exit 1
fi

printf '%s\n' "${notes}"
