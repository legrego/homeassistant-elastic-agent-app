#!/usr/bin/env bash
# Runs the web UI alongside the agent (ha-agent-start).
#
# If the agent can't get going, because the options are missing or wrong, or
# a Fleet agent stops before it has enrolled, the container keeps running so
# the web UI can be used to fix the settings. Once the agent is running, it
# stopping ends the container with a failure, so Home Assistant shows the app
# as stopped and its watchdog can restart it.
set -euo pipefail
export DATA_DIR="${DATA_DIR:-/data}"
export CONFIG_DIR="${CONFIG_DIR:-/run/ha-elastic-agent}"
export OPTIONS_FILE="${OPTIONS_FILE:-/data/options.json}"
export STATE_PATH="${DATA_DIR}/state"
mkdir -p "${CONFIG_DIR}"
chmod 700 "${CONFIG_DIR}"
umask 077
: >"${CONFIG_DIR}/startup.log"
rm -f "${CONFIG_DIR}/startup.json" "${CONFIG_DIR}/agent-stopped"

log() {
    printf '[ha-entrypoint] %s\n' "$*" >&2
    printf '[ha-entrypoint] %s\n' "$*" >>"${CONFIG_DIR}/startup.log" 2>/dev/null || true
}

# tini -g forwards shutdown to the entire process group, including the agent.
trap 'wait; exit 0' TERM INT

# The status page gets only what it needs from the environment, not the
# enrollment token. It's restarted if it stops, and never stops the agent.
(
    while true; do
        env -i PATH="${PATH}" STATE_PATH="${STATE_PATH}" \
            SUPERVISOR_TOKEN="${SUPERVISOR_TOKEN:-}" \
            SUPERVISOR_URL="${SUPERVISOR_URL:-http://supervisor}" \
            STATUS_LISTEN="${STATUS_LISTEN:-:8099}" \
            STATUS_ALLOWED_IPS="${STATUS_ALLOWED_IPS:-172.30.32.2}" \
            OPTIONS_FILE="${OPTIONS_FILE}" DATA_DIR="${DATA_DIR}" CONFIG_DIR="${CONFIG_DIR}" \
            ha-status-server || log "WARNING: The status page stopped (exit code $?). Restarting it."
        sleep 5
    done
) &

ha-agent-start "$@" &
code=0
wait "$!" || code=$?

# ha-agent-start writes startup.json just before it hands over to Elastic Agent,
# so without it the app's own checks or Elasticsearch setup failed. A Fleet
# agent retries enrollment until it succeeds and saves fleet.enc once it has,
# so a Fleet agent without it stopped because Fleet refused the enrollment.
if [[ -f "${CONFIG_DIR}/startup.json" ]] &&
    { [[ "$(jq -r '.mode' "${CONFIG_DIR}/startup.json")" != fleet ]] || [[ -f "${STATE_PATH}/fleet.enc" ]]; }; then
    log "ERROR: Elastic Agent stopped (exit code ${code}). Stopping the app."
    # Supervisor's watchdog only restarts an app that exits with a failure.
    exit "$((code == 0 ? 1 : code))"
fi

log "Elastic Agent isn't running (exit code ${code}). Correct the settings in the web UI or the Configuration tab, then restart the app."
: >"${CONFIG_DIR}/agent-stopped"
wait
